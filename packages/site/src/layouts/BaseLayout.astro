---
import { ClientRouter } from "astro:transitions";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { getData } from "../lib/data";
import "../styles/global.css";
import "../styles/moss.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedAt?: string;
  updatedAt?: string;
  tags?: string[];
}

const { site, posts } = await getData();
const {
  title,
  description,
  type = "website",
  publishedAt,
  updatedAt,
  tags = [],
} = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.description}`;
const pageDescription = description ?? site.description;
const defaultSkin = site.skin; // journal | moss（站长默认；访客 localStorage 覆盖）
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const structuredData =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: pageDescription,
        datePublished: publishedAt,
        dateModified: updatedAt,
        author: site.author ? { "@type": "Person", name: site.author } : undefined,
        keywords: tags.join(","),
        mainEntityOfPage: canonical,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: site.title,
        description: site.description,
        url: new URL("/", Astro.site ?? Astro.url).toString(),
      };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* 手帐字体：霞鹜文楷；溪石标题用 Fraunces；代码用 JetBrains Mono */}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1/style.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600..800&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script define:vars={{ defaultSkin }}>
      // 防闪烁：首帧前锁定 data-theme / data-skin；同时标记 js 供滚动显现降级
      (function () {
        var t = localStorage.getItem("blog-theme");
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
        document.documentElement.dataset.skin = localStorage.getItem("blog-skin") || defaultSkin;
        document.documentElement.classList.add("js");
        // 软导航（ClientRouter swap）不重跑首帧脚本，换页后在此恢复
        document.addEventListener("astro:after-swap", function () {
          var root = document.documentElement;
          root.dataset.theme = localStorage.getItem("blog-theme") || t;
          root.dataset.skin = localStorage.getItem("blog-skin") || defaultSkin;
          root.classList.add("js");
        });
      })();
    </script>
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <Masthead site={site} postCount={posts.length} />
    <main class="container main">
      <slot />
    </main>
    <Footer site={site} />
    <SearchDialog />
    <script>
      // 主题切换（刊头按钮；与后台共用同一 localStorage 键）
      function syncThemeLabels(): void {
        var dark = document.documentElement.dataset.theme === "dark";
        document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
          var on = btn.querySelector("[data-theme-label-on]");
          var off = btn.querySelector("[data-theme-label-off]");
          if (on && off) {
            on.hidden = !dark;
            off.hidden = dark;
          }
        });
      }
      document.addEventListener("click", function (e) {
        var btn = (e.target as Element).closest("[data-theme-toggle]");
        if (!btn) return;
        var root = document.documentElement;
        var next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("blog-theme", next);
        syncThemeLabels();
      });

      // 吸顶纸条滚动投影
      function syncScrolled(): void {
        var m = document.querySelector("[data-masthead]");
        if (m) m.classList.toggle("is-scrolled", window.scrollY > 8);
      }

      function onPageLoad(): void {
        syncThemeLabels();
        syncSkinLabels();
        syncScrolled();
      }
      document.addEventListener("astro:page-load", onPageLoad);
      window.addEventListener(
        "scroll",
        function () {
          syncScrolled();
        },
        { passive: true },
      );
      document.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-skin-toggle]");
        if (!btn) return;
        var root = document.documentElement;
        var next = root.dataset.skin === "moss" ? "journal" : "moss";
        root.dataset.skin = next;
        localStorage.setItem("blog-skin", next);
        syncSkinLabels();
      });

      function syncSkinLabels(): void {
        var obs = document.documentElement.dataset.skin === "moss";
        document.querySelectorAll("[data-skin-toggle]").forEach(function (btn) {
          var on = btn.querySelector("[data-skin-label-on]");
          var off = btn.querySelector("[data-skin-label-off]");
          if (on && off) {
            on.hidden = obs; // 当前是观星台 → 显示「手帐」（切回目标）
            off.hidden = !obs;
          }
        });
      }
      onPageLoad();
    </script>
  </body>
</html>

<style>
  .main {
    margin-top: var(--space-2xl);
    min-height: 50vh;
  }
</style>
