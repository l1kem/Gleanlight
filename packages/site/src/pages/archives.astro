---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getData, postDate } from "../lib/data";

const { posts } = await getData();
const byYear = new Map<number, typeof posts>();
for (const p of [...posts].sort((a, b) => (a.publishedAt > b.publishedAt ? -1 : 1))) {
  const y = Number((p.publishedAt || "").slice(0, 4)) || new Date().getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="归档" description="按年份归档的全部文章。">
  <section class="rail reveal" style="--i: 0">
    <div class="rail__head">
      <h1 class="rail__title">归档</h1>
      <span class="stamp">{posts.length} 篇在册</span>
    </div>
    {years.map((y) => (
      <div class="year">
        <h2 class="year__no">{y}</h2>
        <ul class="rowlist">
          {byYear.get(y)!.map((p) => (
            <li>
              <time datetime={p.publishedAt}>{postDate(p.publishedAt).slice(5)}</time>
              <a class="rowlist__title" href={`/posts/${p.slug}`}>{p.title}</a>
              {p.topicName && <span class="rowlist__meta">{p.topicName}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
    {posts.length === 0 && <p class="muted">还没有可归档的文章。</p>}
  </section>
</BaseLayout>

<style>
  h1.rail__title {
    font-size: var(--text-xl);
    margin: 0;
  }
  /* 年份 = 圆形印章 */
  .year__no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.2em;
    height: 3.2em;
    padding-inline: 0.6em;
    background: var(--color-accent-wash);
    color: var(--color-accent-ink);
    border: 2px dashed var(--color-accent);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    margin: var(--space-2xl) 0 var(--space-sm);
    transform: rotate(-3deg);
    font-variant-numeric: tabular-nums;
  }
</style>
