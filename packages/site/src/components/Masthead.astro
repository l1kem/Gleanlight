---
import type { SiteInfo } from "../lib/data";

interface Props {
  site: SiteInfo;
  postCount: number;
}

const { site, postCount } = Astro.props;

const nav = [
  { href: "/", label: "首页" },
  { href: "/posts", label: "文章" },
  { href: "/kb", label: "知识库" },
  { href: "/archives", label: "归档" },
  { href: "/about", label: "关于" },
];
const today = new Date();
const issueNo = `${today.getFullYear()} · ${String(today.getMonth() + 1).padStart(2, "0")} 月刊`;

const isHere = (href: string) =>
  Astro.url.pathname === href ||
  (href !== "/" && Astro.url.pathname.startsWith(`${href}/`));
---

<header class="masthead" data-masthead>
  <div class="container masthead__inner">
    <div class="masthead__brand">
      <span class="masthead__tape tape tape--red" aria-hidden="true"></span>
      <a href="/" class="masthead__wordmark">{site.title}</a>
      <p class="masthead__intro">
        <span class="masthead__intro-line">{site.mastheadIntro}</span>
        <span class="masthead__issue">{issueNo} · 藏文 {postCount} 篇</span>
      </p>
    </div>

    <div class="masthead__side">
      <nav class="masthead__nav" aria-label="主导航">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={["masthead__link", { "is-here": isHere(item.href) }]}
          >
            {item.label}
          </a>
        ))}
        <a href="#search" class="masthead__link" data-search-open>搜索</a>
      </nav>
      <div class="masthead__modes">
        <button class="masthead__skin" type="button" data-skin-toggle aria-label="切换界面风格" title="切换界面风格（手帐 / 观星台）">
          <span data-skin-label-on>手帐</span>
          <span data-skin-label-off hidden>观星台</span>
        </button>
        <button class="masthead__theme" type="button" data-theme-toggle aria-label="切换深浅色">
          <span data-theme-label-on>浅色</span>
          <span data-theme-label-off hidden>深色</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  /* 吸顶纸条：右上角贴纸页签导航 */
  .masthead {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    border-bottom: 1.5px dashed var(--color-rule-strong);
    background: color-mix(in oklch, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: box-shadow var(--dur-short) var(--ease-out);
  }
  .masthead.is-scrolled {
    box-shadow: 0 4px 16px -8px color-mix(in oklch, var(--color-ink) 30%, transparent);
  }
  .masthead__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    flex-wrap: wrap;
  }

  /* 左：手帐封面字标 + 一行小注 */
  .masthead__brand {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    min-width: 0;
    padding-top: var(--space-2xs);
  }
  .masthead__tape {
    width: 2.75rem;
    height: 1rem;
    top: -0.28rem;
    left: -0.9rem;
    transform: rotate(-38deg);
  }
  .masthead__wordmark {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-ink-strong);
    text-decoration: none;
    display: inline-block;
    white-space: nowrap;
    transition: color var(--dur-short) var(--ease-out);
  }
  .masthead__wordmark:hover {
    color: var(--color-accent);
  }
  .masthead__intro {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    min-width: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    color: var(--color-neutral);
  }
  .masthead__intro-line {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 22rem;
  }
  .masthead__issue {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* 右：贴纸页签 + 主题切换 */
  .masthead__side {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .masthead__nav {
    display: flex;
    gap: var(--space-2xs);
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .masthead__link {
    display: inline-block;
    color: var(--color-muted);
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule-strong);
    border-radius: 8px;
    padding: var(--space-3xs) var(--space-sm);
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    white-space: nowrap;
    box-shadow: var(--shadow-paper);
    transition: transform var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }
  .masthead__nav .masthead__link:nth-child(odd) { transform: rotate(-0.8deg); }
  .masthead__nav .masthead__link:nth-child(even) { transform: rotate(0.6deg); }
  .masthead__link:hover {
    color: var(--color-ink-strong);
    text-decoration: none;
    transform: translateY(-2px) rotate(0deg);
    border-color: var(--color-ink);
  }
  .masthead__link:focus-visible {
    transform: rotate(0deg);
  }
  .masthead__link.is-here {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-paper-2);
    transform: rotate(-1deg);
  }
  .masthead__link.is-here:hover {
    transform: translateY(-2px) rotate(-1deg);
  }
  .masthead__modes {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .masthead__skin,
  .masthead__theme {
    border: 1px dashed var(--color-rule-strong);
    background: var(--color-paper-2);
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-xs);
    padding: var(--space-3xs) var(--space-sm);
    border-radius: var(--radius-pill);
    cursor: pointer;
    white-space: nowrap;
    transform: rotate(2deg);
    transition: color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out),
      transform var(--dur-short) var(--ease-out);
  }
  .masthead__skin:hover,
  .masthead__theme:hover {
    color: var(--color-ink);
    border-color: var(--color-ink);
    transform: rotate(0deg);
  }

  @media (max-width: 64rem) {
    .masthead__intro {
      display: none;
    }
  }
  @media (max-width: 40rem) {
    .masthead__inner {
      padding-block: var(--space-xs);
    }
    .masthead__brand {
      padding-top: var(--space-3xs);
    }
    .masthead__wordmark {
      font-size: var(--text-xl);
    }
    .masthead__side {
      margin-left: auto;
    }
    .masthead__nav {
      gap: var(--space-3xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead {
      transition: none;
    }
  }
</style>
