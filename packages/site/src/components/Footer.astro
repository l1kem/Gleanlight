---
import type { SiteInfo } from "../lib/data";

interface Props {
  site: SiteInfo;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="letterfoot">
  <span class="letterfoot__cat" aria-hidden="true">
    <svg viewBox="0 0 72 46" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M29.5 9.5 L25.5 3 L32 6.5"></path>
      <path d="M42.5 9.5 L46.5 3 L40 6.5"></path>
      <path d="M26.5 13 a9.5 9.5 0 0 1 19 0 q1 7.5 -2.5 11 h-14 q-3.5 -3.5 -2.5 -11 z"></path>
      <circle cx="31.5" cy="13" r="1.1" fill="currentColor" stroke="none"></circle>
      <circle cx="40.5" cy="13" r="1.1" fill="currentColor" stroke="none"></circle>
      <path d="M36 16.5 v1.6 m0 0 q-1.8 1.8 -3.2 0.4 M36 18.1 q1.8 1.8 3.2 0.4"></path>
      <path d="M24 14 h-4.5 M24.5 17 l-4 2 M48 14 h4.5 M47.5 17 l4 2"></path>
      <path d="M27.5 24.5 q-6 9 -3 17.5 h23 q3 -8.5 -3 -17.5"></path>
      <path d="M50.5 42 q9.5 -1 8 -9.5 q-0.8 -4 -4.5 -4.8"></path>
    </svg>
  </span>
  <div class="container letterfoot__inner">
    <p class="letterfoot__note">{site.footerNote}</p>
    <p class="letterfoot__sign">
      {site.author ? `${site.author} · ` : ""}{year}
      {site.social.map((s) => (
        <a class="letterfoot__social" href={s.url} rel="noopener">{s.label}</a>
      ))}
      <a class="letterfoot__social" href="/rss.xml">RSS</a>
    </p>
    <span class="stamp stamp--onload letterfoot__stamp" aria-hidden="true">{site.title} · {year}</span>
  </div>
</footer>

<style>
  .letterfoot {
    position: relative;
    margin-top: var(--space-4xl);
    border-top: 2px dashed var(--color-rule-strong);
    padding-block: var(--space-xl);
  }
  /* 猫涂鸦贴纸，坐在撕纸线上 */
  .letterfoot__cat {
    position: absolute;
    right: clamp(1rem, 12vw, 9rem);
    top: -22px;
    width: 62px;
    padding: 1px 4px 0;
    color: var(--color-muted);
    background: var(--color-paper);
    border-radius: 6px;
    box-shadow: var(--shadow-paper);
  }
  .letterfoot__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .letterfoot__note {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--color-muted);
  }
  .letterfoot__sign {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-neutral);
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  .letterfoot__social {
    color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .letterfoot__stamp {
    position: absolute;
    right: 0;
    bottom: 0;
  }
  @media (max-width: 48rem) {
    .letterfoot__stamp {
      position: static;
      align-self: flex-end;
      margin-top: var(--space-sm);
    }
    .letterfoot__cat {
      right: 1.5rem;
    }
  }
</style>
