---
/**
 * 搜索弹层：导航「搜索」或按 / 键唤起，页面中上弹出，即敲即搜。
 * 索引首次打开时从独立 JSON 加载，避免每个静态页面重复内联全站数据。
 */
---

<div class="search-layer" id="search-layer" hidden aria-hidden="true">
  <div class="search-dialog" role="dialog" aria-modal="true" aria-label="搜索">
    <div class="search-bar">
      <span class="search-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m15.5 15.5 5 5"></path>
        </svg>
      </span>
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder="搜索文章（标题 / 摘要 / 标签）…"
        autocomplete="off"
      />
      <button class="search-close" type="button" data-search-close aria-label="关闭">esc</button>
    </div>
    <p class="search-count muted small" id="search-count"></p>
    <ul class="search-results" id="search-results"></ul>
    <p class="search-foot muted small">
      <span class="search-kbd">/</span> 唤起 · <span class="search-kbd">↵</span> 打开第一条 · <span class="search-kbd">esc</span> 关闭
    </p>
  </div>
</div>

<script>
  (function () {
    // 软导航（ClientRouter swap）会替换 DOM：元素必须每次现场查询，
    // 缓存引用会指向被移除的旧节点（曾导致点击搜索无反应）。
    var byId = function (id) { return document.getElementById(id); };
    var current = [];
    var index = [];
    var loaded = false;
    var lastTrigger = null;

    async function loadIndex() {
      if (loaded) return true;
      var count = byId("search-count");
      if (count) count.textContent = "正在翻阅索引…";
      try {
        var response = await fetch("/search-index.json", { headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error("索引读取失败");
        var payload = await response.json();
        index = Array.isArray(payload) ? payload : [];
        loaded = true;
        return true;
      } catch {
        index = [];
        loaded = false;
        if (count) count.textContent = "暂时无法读取搜索索引";
        return false;
      }
    }

    function esc(s) {
      return String(s).replace(/[&<>"]/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
      });
    }

    function render(items) {
      current = items;
      var results = byId("search-results");
      var count = byId("search-count");
      results.innerHTML = items
        .slice(0, 30)
        .map(function (p, i) {
          return (
            '<li><a class="search-hit" href="/posts/' +
            encodeURIComponent(p.slug) +
            '" data-i="' + i + '">' +
            '<span class="search-hit__title">' + esc(p.title) + "</span>" +
            (p.excerpt ? '<span class="search-hit__excerpt">' + p.excerpt + "</span>" : "") +
            '<span class="search-hit__meta">' + esc(p.topic || "") + " · " + esc(p.date) + "</span>" +
            "</a></li>"
          );
        })
        .join("");
      count.textContent = items.length
        ? items.length + " 篇可检索" + (items.length > 30 ? "（显示前 30）" : "")
        : "没有匹配的文章";
    }

    // ── pagefind 全文索引（构建后生成 /pagefind/；加载失败回退元数据检索）
    var pagefind = null;
    async function loadPagefind() {
      if (pagefind !== null) return pagefind;
      try {
        // 变量形式的动态导入：Vite 不解析，运行时直接从构建产物加载
        var pfUrl = "/pagefind/pagefind.js";
        var mod = await import(/* @vite-ignore */ pfUrl);
        await mod.options({ excerptLength: 16 });
        pagefind = mod;
      } catch {
        pagefind = false;
      }
      return pagefind;
    }

    async function pagefindSearch(kw) {
      var pf = await loadPagefind();
      if (!pf) return null;
      try {
        var res = await pf.search(kw);
        var hits = await Promise.all(res.results.slice(0, 30).map(function (r) { return r.data(); }));
        return hits.map(function (h) {
          var slug = (h.url || "").replace(/^\/posts\//, "").replace(/\/$/, "");
          return {
            slug: slug,
            title: (h.meta && h.meta.title) || h.url,
            topic: "",
            date: "",
            excerpt: h.excerpt ? h.excerpt.replace(/<mark>/g, "<mark>").slice(0, 160) : ""
          };
        });
      } catch {
        return null;
      }
    }

    async function search(q) {
      var kw = q.trim().toLowerCase();
      if (!kw) {
        render(index);
        return;
      }
      var hits = await pagefindSearch(kw);
      if (hits === null) {
        hits = index.filter(function (p) {
          return [p.title, p.summary, p.tags.join(" "), p.topic].join(" ").toLowerCase().includes(kw);
        });
      }
      render(hits);
    }

    async function open(trigger) {
      var layer = byId("search-layer");
      var input = byId("search-input");
      if (!layer) return;
      lastTrigger = trigger || document.activeElement;
      layer.hidden = false;
      layer.setAttribute("aria-hidden", "false");
      document.documentElement.style.overflow = "hidden";
      input.value = "";
      if (await loadIndex()) render(index);
      setTimeout(function () {
        input.focus();
      }, 20);
    }

    function close() {
      var layer = byId("search-layer");
      if (!layer) return;
      layer.hidden = true;
      layer.setAttribute("aria-hidden", "true");
      document.documentElement.style.overflow = "";
      if (lastTrigger && typeof lastTrigger.focus === "function") lastTrigger.focus();
      lastTrigger = null;
    }

    document.addEventListener("click", function (e) {
      var t = e.target.closest ? e.target.closest("[data-search-open]") : null;
      if (t) {
        e.preventDefault();
        void open(t);
        return;
      }
      var layer = byId("search-layer");
      if (e.target.closest("[data-search-close]") || (layer && e.target === layer)) {
        close();
      }
    });

    document.addEventListener("keydown", function (e) {
      var layer = byId("search-layer");
      if (!layer) return;
      if (e.key === "Escape" && !layer.hidden) {
        close();
        return;
      }
      if (e.key === "Tab" && !layer.hidden) {
        var focusable = Array.from(
          layer.querySelectorAll('input, button, a[href], [tabindex]:not([tabindex="-1"])'),
        ).filter(function (el) { return !el.disabled && !el.hidden; });
        if (focusable.length) {
          var first = focusable[0];
          var last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
      var tag = (document.activeElement && document.activeElement.tagName) || "";
      if (e.key === "/" && tag !== "INPUT" && tag !== "TEXTAREA") {
        e.preventDefault();
        void open(document.activeElement);
      }
      if (e.key === "Enter" && !layer.hidden && current[0]) {
        location.href = "/posts/" + encodeURIComponent(current[0].slug);
      }
    });

    // input 事件委托：软导航后的新输入框同样生效
    document.addEventListener("input", function (e) {
      if (e.target && e.target.id === "search-input") search(e.target.value);
    });
  })();
</script>

<style>
  .search-layer {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: var(--color-scrim);
    /* 背景整体模糊压暗：弹层后的内容不再透出叠影 */
    backdrop-filter: blur(10px) saturate(0.9);
    -webkit-backdrop-filter: blur(10px) saturate(0.9);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 14vh var(--space-lg) var(--space-lg);
  }
  .search-layer[hidden] {
    display: none;
  }
  .search-dialog {
    width: min(36rem, 100%);
    max-height: 62vh;
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1.5px dashed var(--color-rule-strong);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-paper);
    overflow: clip;
  }
  .search-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-paper-2);
    border-bottom: 1px dashed var(--color-rule);
    outline: 2px solid transparent;
    outline-offset: -2px;
  }
  .search-bar:focus-within {
    outline-color: var(--color-focus);
  }
  .search-icon {
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
    color: var(--color-accent);
  }
  .search-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .search-input {
    flex: 1;
    min-height: 2.75rem;
    border: none;
    background: transparent;
    font: inherit;
    font-size: var(--text-md);
    color: var(--color-ink);
  }
  .search-input:focus-visible {
    outline: none;
  }
  .search-close {
    min-height: 2.75rem;
    border: 1px dashed var(--color-rule-strong);
    background: none;
    border-radius: var(--radius-pill);
    color: var(--color-neutral);
    font: inherit;
    font-size: var(--text-xs);
    padding: var(--space-3xs) var(--space-sm);
    cursor: pointer;
  }
  .search-close:active {
    transform: translateY(1px);
  }
  .search-count {
    margin: 0;
    padding: var(--space-2xs) var(--space-md) 0;
  }
  .search-results {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: var(--space-2xs);
    overflow-y: auto;
    flex: 1;
  }
  .search-hit {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
    min-height: 2.75rem;
  }
  .search-hit:hover,
  .search-hit:focus-visible {
    background: var(--color-paper-3);
  }
  .search-hit__title {
    color: var(--color-ink-strong);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .search-hit__meta {
    font-size: var(--text-xs);
    color: var(--color-neutral);
    font-variant-numeric: tabular-nums;
  }
  .search-hit__excerpt {
    font-size: var(--text-xs);
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  .search-hit__excerpt :global(mark),
  .search-hit__excerpt mark {
    color: var(--color-accent);
    background: none;
    font-weight: 700;
  }
  .search-foot {
    margin: 0;
    padding: var(--space-2xs) var(--space-md);
    border-top: 1px dashed var(--color-rule);
    display: flex;
    gap: var(--space-2xs);
    align-items: center;
  }
  .search-kbd {
    display: inline-block;
    min-width: 1.4em;
    text-align: center;
    padding: 0 0.25em;
    border: 1px solid var(--color-rule-strong);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75em;
    color: var(--color-muted);
  }
</style>
